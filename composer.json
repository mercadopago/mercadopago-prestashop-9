{
  "name": "mercadopago/prestashop-v2",
  "description": "MercadoPago payment module for PrestaShop - Version 5.0.0",
  "license": "OSL-3.0",
  "type": "prestashop-module",
  "keywords": [
    "prestashop",
    "payment",
    "mercadopago",
    "ecommerce"
  ],
  "authors": [
    {
      "name": "MercadoPago",
      "email": "developers@mercadopago.com",
      "homepage": "https://www.mercadopago.com"
    }
  ],
  "config": {
    "prepend-autoloader": false,
    "sort-packages": true,
    "optimize-autoloader": true,
    "platform": {
      "php": "8.1.0"
    },
    "allow-plugins": {
      "composer/package-versions-deprecated": true
    }
  },
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-openssl": "*",
    "doctrine/annotations": "^2.0",
    "doctrine/dbal": "^3.6",
    "doctrine/migrations": "^3.6",
    "doctrine/orm": "^3.5",
    "guzzlehttp/guzzle": "^7.5",
    "monolog/monolog": "^3.0",
    "mp-plugins/php-sdk": "2.13.0",
    "symfony/config": "^6.0",
    "symfony/dependency-injection": "^6.0",
    "symfony/form": "^6.0",
    "symfony/http-client": "^6.0",
    "symfony/http-foundation": "^6.0",
    "symfony/validator": "^6.0",
    "symfony/yaml": "^6.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.0",
    "mockery/mockery": "^1.6",
    "phpstan/phpstan": "^1.10",
    "phpstan/phpstan-symfony": "^1.3",
    "phpstan/phpstan-doctrine": "^1.3",
    "symfony/phpunit-bridge": "^6.0",
    "phpunit/php-code-coverage": "^10.1",
    "phpunit/phpunit": "^10.5",
    "squizlabs/php_codesniffer": "^3.13"
  },
  "scripts": {
    "lint": [
      "Composer\\Config::disableProcessTimeout",
      "phpcs --extensions=php --warning-severity=0 --standard=phpcs.xml ."
    ],
    "lint:fix": [
      "Composer\\Config::disableProcessTimeout",
      "phpcbf --extensions=php --standard=phpcs.xml ."
    ],
    "cs": [
      "Composer\\Config::disableProcessTimeout",
      "php-cs-fixer fix --config=.php-cs-fixer.php --verbose"
    ],
    "cs:check": [
      "Composer\\Config::disableProcessTimeout",
      "php-cs-fixer fix --config=.php-cs-fixer.php --dry-run --diff --verbose"
    ],
    "stan": [
      "Composer\\Config::disableProcessTimeout",
      "phpstan analyse --configuration=phpstan.neon --memory-limit=512M"
    ],
    "quality": [
      "@lint",
      "@cs:check",
      "@stan",
      "./bin/validate-dependency-injection.sh"
    ],
    "quality:fix": [
      "@lint:fix",
      "@cs"
    ],
    "fix-all": [
      "Composer\\Config::disableProcessTimeout",
      "@lint:fix",
      "@cs",
      "echo '✅ Todas as correções automáticas foram aplicadas!'"
    ],
    "dev-check": [
      "Composer\\Config::disableProcessTimeout",
      "@fix-all",
      "@stan",
      "echo '🎯 Código pronto para desenvolvimento!'"
    ],
    "pre-commit": [
      "@dev-check"
    ],
    "test": [
      "Composer\\Config::disableProcessTimeout",
      "phpunit"
    ],
    "test:coverage": [
      "Composer\\Config::disableProcessTimeout",
      "phpunit --coverage-html coverage"
    ],
    "test:unit": [
      "Composer\\Config::disableProcessTimeout",
      "phpunit --testsuite=Unit"
    ],
    "test:integration": [
      "Composer\\Config::disableProcessTimeout",
      "phpunit --testsuite=Integration"
    ],
    "test:all": [
      "@test",
      "@quality"
    ],
    "zip": [
      "Composer\\Config::disableProcessTimeout",
      "./bin/create-release-zip.sh"
    ],
    "validate-di": [
      "Composer\\Config::disableProcessTimeout",
      "./bin/validate-dependency-injection.sh"
    ]
  },
  "autoload": {
    "psr-4": {
      "MercadoPago\\": "src/"
    },
    "classmap": [
      "controllers/front/AbstractMercadopagoModuleFrontController.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "MercadoPago\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
