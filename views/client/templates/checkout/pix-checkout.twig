<div class="mp-checkout-pix">

    <div class="mp-pix-logo-section">
        <img class="mp-pix-logo" src="{{ module_dir }}views/client/img/logo_pix.png" alt="PIX" />
        <label class="mp-pix-text-label">
            <strong>{{ l('When you confirm the purchase, ') }}</strong><br>
            {{ l('you will be able to see the code to make the instant payment.') }}
        </label>
    </div>

    <div class="mp-pix-info-section">
        <img class="mp-badge-info" src="{{ module_dir }}views/client/img/icons/badge_info_gray.png" alt="" />
        <label class="mp-pix-text-info">
            {{ l('Pix has a daily transfer limit.') }}<br>
            {{ l('Please contact your bank for more information.') }}
        </label>
    </div>

    <div class="mp-pix-terms-section">
        <p class="mp-label-checkout-custom">
            {{ l('By continuing, you agree to our ') }}
            <a class="mp-link-checkout-custom" href="{{ terms_url|default('#') }}" target="_blank">
                {{ l('Terms and Conditions') }}
            </a>
        </p>
    </div>

</div>
