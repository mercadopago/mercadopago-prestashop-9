<form action="{{ action_url }}" id="mp-custom-checkout" class="mp-checkout-form" method="POST">
    <div class="row mp-container-payment-card">

        <input type="hidden" id="mp-site-id" value="{{ site_id }}">

        {% if wallet_button %}
            <div class='col-xs-12 col-md-12 col-12 mp-px-0'>
                <div class='mp-wallet-button-container'>
                    <div class='mp-wallet-title'>
                        <p>{{ wallet_button_title }}</p>
                    </div>
                    <div class='mp-wallet-description'>
                        <p>{{ wallet_button_description }}</p>
                    </div>
                    <div class='mp-wallet-button-section'>
                        <button type='button' id='mp-wallet-button'>
                            <img src="https://http2.mlstatic.com/storage/cpp/static-files/c8931485-44eb-4841-b372-690f92a496a2.png">
                        </button>
                    </div>
                </div>
            </div>
        {% endif %}

        <div class="col-xs-12 col-md-12 col-12 mp-frame-title">
            <a id="button-show-payments" class="mp-link">
                {{ l('With what cards can I pay') }} ⌵
            </a>

            {% if site_id|upper == 'MLA' %}
                <span class="mp-separate-promotion-link"> | </span>
                <a href="https://www.mercadopago.com.ar/cuotas" target="_blank" class="mp-link">
                    {{ l('See current promotions') }}
                </a>
            {% endif %}
        </div>

        <!-- Accepted payment methods logos -->
        <div class="col-xs-12 col-md-12 col-12 mp-frame-title">
            <div class="mp-frame-payments mp-hidden" id="mp-frame-payments">
                {% if credit_cards|length > 0 %}
                    <p class="mp-subtitle-payments">{{ l('Credit card') }}</p>
                    <div class="mp-payment-methods-container">
                        {% for card in credit_cards %}
                            <div class="mp-payment-method-logo-container">
                                <img src="{{ card.image|e }}" alt="{{ card.name|e }}" class="mp-payment-method-logo-image" />
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}

                {% if debit_cards|length > 0 %}
                    <p class="mp-subtitle-payments">{{ l('Debit card') }}</p>
                    <div class="mp-payment-methods-container">
                        {% for card in debit_cards %}
                            <div class="mp-payment-method-logo-container">
                                <img src="{{ card.image|e }}" alt="{{ card.name|e }}" class="mp-payment-method-logo-image" />
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>

        <!-- Title enter your card details -->
        <div class="col-xs-12 col-md-12 col-12 mp-frame-title">
            <h3 class="mp-title-custom-checkout">
                {{ l('Enter your card details') }}
            </h3>

            <!-- Input Card number -->
            <div class="form-group">
                <div class="col-md-12 col-12 mp-pb-10 mp-px-0">
                    <label for="id-card-number" class="mp-pb-5">
                        {{ l('Card number') }}
                        <em class="mp-required">*</em>
                    </label>
                    <input
                        id="id-card-number"
                        class="form-control mp-form-control"
                        type="text"
                        maxlength="24"
                        autocomplete="off"
                        data-checkout="cardNumber" 
                    />
                    <small id="mp-error-205" class="mp-erro-form" data-main="#id-card-number">
                        {{ l('Invalid card number') }}
                    </small>
                    <small id="mp-error-E301" class="mp-erro-form mp-error-E301" data-main="#id-card-number">
                        {{ l('Invalid card number') }}
                    </small>
                </div>
            </div>

            <!-- Input Name and Surname -->
            <div id="mp-card-holder-div" class="form-group mp-hidden">
                <div class="col-md-12 col-12 mp-pb-10 mp-px-0">
                    <label for="id-card-holder-name" class="mp-pb-5">
                        {{ l('Name and surname of the cardholder') }}
                        <em class="mp-required">*</em>
                    </label>
                    <input
                        id="id-card-holder-name"
                        class="form-control mp-form-control"
                        type="text"
                        autocomplete="off"
                        data-checkout="cardholderName"
                    />
                    <small id="mp-error-221" class="mp-erro-form" data-main="#id-card-holder-name">
                        {{ l('Invalid card holder name') }}
                    </small>
                    <small id="mp-error-316" class="mp-erro-form" data-main="#id-card-holder-name">
                        {{ l('Invalid card holder name') }}
                    </small>
                </div>
            </div>

            <!-- Input expiration date -->
            <div class="form-group">
                <div class="col-md-6 col-6 mp-pb-20 mp-pl-0">
                    <label for="id-card-expiration" class="mp-pb-5">
                        {{ l('Expiration date') }}
                        <em class="mp-required">*</em>
                    </label>
                    <input
                        id="id-card-expiration"
                        class="form-control mp-form-control"
                        type="text"
                        autocomplete="off"
                        placeholder="MM/AAAA"
                        maxlength="7"
                        data-checkout="cardExpiration" 
                    />
                    <input id="id-card-expiration-month" type="hidden" />
                    <input id="id-card-expiration-year" type="hidden" />

                    <small id="mp-error-208" class="mp-erro-form" data-main="#id-card-expiration">
                        {{ l('Invalid card expiration date') }}
                    </small>
                    <small id="mp-error-209" class="mp-erro-form" data-main="#id-card-expiration">
                        {{ l('Invalid card expiration date') }}
                    </small>
                    <small id="mp-error-325" class="mp-erro-form" data-main="#id-card-expiration">
                        {{ l('Invalid card expiration date') }}
                    </small>
                    <small id="mp-error-326" class="mp-erro-form" data-main="#id-card-expiration">
                        {{ l('Invalid card expiration date') }}
                    </small>
                    <small id="mp-error-E205" class="mp-erro-form" data-main="#id-card-expiration">
                        {{ l('Invalid card expiration date') }}
                    </small>
                    <small id="mp-error-301" class="mp-erro-form" data-main="#id-card-expiration">
                        {{ l('Invalid card expiration date') }}
                    </small>
                </div>

                <!-- Input security code -->
                <div class="col-md-6 col-6 mp-pb-20 mp-pr-0">
                    <label for="id-security-code" class="mp-pb-5">
                        {{ l('Security code') }}
                        <em class="mp-required">*</em>
                    </label>
                    <input
                        id="id-security-code"
                        class="form-control mp-form-control"
                        type="text"
                        autocomplete="off"
                        placeholder="CVV"
                        maxlength="4"
                        data-checkout="securityCode" 
                    />

                    <small class="mp-small mp-frame-title">
                        {{ l('Enter the card security code (3 or 4 digits)') }}
                    </small>
                    <small id="mp-error-224" class="mp-erro-form mp-pt-0" data-main="#id-security-code">
                        {{ l('Invalid security code') }}
                    </small>
                    <small id="mp-error-E302" class="mp-erro-form mp-pt-0" data-main="#id-security-code">
                        {{ l('Invalid security code') }}
                    </small>
                </div>
            </div>

            <!-- Title installments -->
            <div class="col-md-12 col-12 mp-frame-title">
                <h3 class="mp-title-custom-checkout">
                    {{ l('In how many installments do you want to pay') }}
                </h3>
            </div>

            <div class="form-group">
                <div id="container-issuers" class="mp-hidden">
                    <select id="id-issuers-options" data-checkout="issuer"></select>
                </div>

                <!-- Select installments -->
                <div id="container-installments" class="col-md-12 col-8 mp-pb-20 mp-px-0">
                    <label for="id-installments" class="mp-pb-5">
                        {{ l('In how many installments do you want to pay') }}
                    </label>
                    <select
                        id="id-installments"
                        class="form-control mp-form-control mp-select mp-pointer"
                        type="text"
                        data-checkout="installments"
                    >
                    </select>
                    <small id="id-installments-status" class="mp-erro-form"></small>

                    <div class="row">
                        <div class="col-md-12">
                            <div id="mp-mla-tax-text" class="mp-text-mla-tax"></div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Title document -->
            <div id="mp-doc-div-title-document" class="col-md-12 col-12 mp-frame-title mp-hidden">
                <h3 class="mp-title-custom-checkout">
                    {{ l('Enter your document number') }}
                </h3>
            </div>

            <!-- Select document type -->
            <div id="mp-doc-div" class="form-group mp-hidden">
                <div id="mp-doc-type-div" class="col-md-4 col-4 mp-pb-20 mp-pl-0 mp-hidden">
                    <label for="id-docType" class="mp-pb-5">
                        {{ l('Type') }}
                        <em class="mp-required">*</em>
                    </label>

                    <select
                        id="id-docType"
                        data-checkout="docType"
                        class="form-control mp-form-control mp-select mp-pointer"
                    >
                    </select>
                </div>

                <!-- Input doc number -->
                <div id="mp-doc-number-div" class="col-md-8 col-8 mp-pb-20 mp-pr-0 mp-hidden">
                    <label for="id-doc-number" class="mp-pb-5">
                        {{ l('Document number') }}
                        <em class="mp-required">*</em>
                    </label>

                    <input
                        id="id-doc-number"
                        class="form-control mp-form-control"
                        type="text"
                        autocomplete="off"
                        data-checkout="docNumber"
                    />

                    <input type="hidden" id="id-doc-number-clean" />

                    <small id="id-doc-number-error" class="mp-erro-form" style="display: none;">
                        {{ l('Invalid document number') }}
                    </small>
                    <small id="mp-error-324" class="mp-erro-form mp-pt-0" data-main="#id-doc-number" style="display: none;">
                        {{ l('Invalid document number') }}
                    </small>
                </div>
            </div>

            <!-- Message indicating that fields marked with * are required -->
            <div class="col-md-12 col-xs-12 col-12 mp-px-0">
                <p class="mp-all-required">
                    <em class="mp-required">*</em> {{ l('Obligatory field') }}
                </p>
            </div>

            <!-- Terms and Conditions acceptance label -->
            <div>
                <p>
                    {{ l('By continuing, you agree to our ') }}
                    <a class="mp-link" href="{{ terms_url|default('#')|escape('html') }}" target="_blank">
                        {{ l('Terms and Conditions') }}
                    </a>
                </p>
            </div>
        </div>

    </div>

    <div id="mercadopago-utilities">
        <input type="hidden" id="amount" value="{{ amount }}" />
        <input type="hidden" id="card_token_id" name="mercadopago_custom[card_token_id]" />
        <input type="hidden" id="payment_type_id" name="mercadopago_custom[payment_type_id]" />
        <input type="hidden" id="payment_method_id" name="mercadopago_custom[payment_method_id]" />
        <input type="hidden" id="mp_installments" name="mercadopago_custom[installments]" />
        <input type="hidden" id="doc_type" name="mercadopago_custom[doc_type]" />
        <input type="hidden" id="doc_number" name="mercadopago_custom[doc_number]" />
        <input type="hidden" id="mp_issuer" name="mercadopago_custom[issuer]" />
    </div>
</form>

{% if public_key is not empty %}
    <script type="text/javascript">
        document.addEventListener('DOMContentLoaded', function() {
            if (typeof MercadoPago === 'undefined') {
                console.error('[MercadoPago] SDK not loaded');
                return;
            }
            
            if (typeof initializeCustom === 'function') {
                var mp_custom = {
                    site_id: '{{ site_id }}',
                    public_key: '{{ public_key }}',
                    {% if wallet_button %}wallet_button_url: {{ wallet_button_url|json_encode|raw }},{% endif %}
                };

                initializeCustom(mp_custom);
            } else {
                console.error('[MercadoPago] Function initializeCustom not found');
            }
        });
    </script>
{% endif %}
