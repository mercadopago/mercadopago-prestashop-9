<div class="mercadopago-start-selling" style="margin-top: 30px;">
    <div class="panel">
        <div class="panel-heading">
            <i class="icon-cog"></i>
            <span>{{ l('Start selling') }}</span>
        </div>
        <div class="panel-body" style="padding: 20px;">
            <div style="margin-bottom: 20px;">
                <h3 style="margin-top: 0; margin-bottom: 10px; font-weight: 600;">
                    {{ l('You have already gone to production!') }}
                </h3>
                <p style="margin-bottom: 0; color: #555; font-size: 14px; line-height: 1.6;">
                    {{ l('All ready for the takeoff of your sales. Now bring your customers to offer them the best online shopping experience with Mercado Pago.') }}
                </p>
            </div>
            <div style="text-align: right; margin-bottom: 20px;">
                <a href="{{ storeUrl }}" target="_blank" class="btn btn-primary btn-lg" style="padding: 10px 20px; font-size: 16px;">
                    <i class="icon-external-link"></i> {{ l('Visit my store') }}
                </a>
            </div>
            <div style="margin-top: 20px; padding-top: 15px; border-top: 1px solid #eee;">
                <p style="margin: 0; color: #999; font-size: 13px;">
                    {{ l('Something\'s wrong?') }} 
                    <a href="https://www.mercadopago.com/developers/pt/support" target="_blank" style="color: #337ab7; text-decoration: underline;">{{ l('Get in touch with our support.') }}</a>
                </p>
            </div>
        </div>
    </div>
</div>

