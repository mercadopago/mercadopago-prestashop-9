<div id='onboarding-modal' class='mp-credentials-modal'>
    <div class='mp-credentials-modal-content'>
        <div class='mp-credentials-modal-close'>
            <img src='https://http2.mlstatic.com/storage/cpp/static-files/027334cd-c7e8-48fb-829f-48b460ccd13b.png' alt='Close' />
        </div>
        <iframe
            id='credentials-iframe'
            sandbox="allow-scripts allow-top-navigation-by-user-activation"
            src='{{ iframe_url|escape('html_attr') }}'
            frameborder='0'
            width='100%'
            height='100%'
        >
        </iframe>
    </div>
</div>

