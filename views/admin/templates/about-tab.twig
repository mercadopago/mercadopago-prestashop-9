<div role="tabpanel" class="tab-pane" id="tab-about">
    <div class="mp-panel-landing">
        {# Banner Principal #}
        <div class="mercadopago-banner" style="background-image: url('https://http2.mlstatic.com/storage/cpp/static-files/9b486a54-ac9f-4dd7-b2fb-7bc9eee2eb17.png')">
            <div class="row mp-mg-0">
                <div class="col-md-7">
                    <div class="mp-label-banner">
                        <img class="mp-logo-banner" src="https://http2.mlstatic.com/storage/cpp/static-files/cf216978-0e5d-4a2e-b67d-8232b098ae00.png" alt="MercadoPago Logo">
                        <h2 class="mp-title-banner">{{ l('Take off your online sales') }}</h2>
                        <p class="mp-text-banner">{{ l('Offer your customers the best payment experience.') }}</p>
                        <a href="#tab-config" class="btn btn-default mp-btn-banner">{{ l('Configure Mercado Pago') }}</a>
                    </div>
                </div>
            </div>
        </div>
        
        {# Seção de Parcelas #}
        <div class="mercadopago-installments">
            <div class="row mp-row-installments">
                <div class="col-md-6 row-text-installments">
                    <p class="text-installments">
                        {{ l('Show your promotions and sell in installments with the best financing available.') }}
                    </p>
                </div>
                <div class="col-md-6 row-img-installments">
                    <img class="img-fluid mp-img-tarjetitas" src="https://http2.mlstatic.com/storage/cpp/static-files/df9cbe35-cb7f-42cd-aeaf-4b62d239020e.png" alt="{{ l('Installments') }}"/>
                </div>
            </div>
            <div class="row text-center">
                <div class="col-md-12">
                    <p class="mp-info-installments">{{ l('We will charge a commission for each payment you receive') }}</p>
                </div>
            </div>
        </div>
        
        {# Seção de Benefícios #}
        <div class="mercadopago-beneficios">
            <div class="row">
                <div class="col-md-6">
                    <h2 class="mp-title-beneficios">
                        {{ l('What are the benefits of accepting payments with Mercado Pago?') }}
                    </h2>
                    
                    <div class="mp-panel-text-icon">
                        <img class="img-fluid icon-mercadopago" src="https://http2.mlstatic.com/storage/cpp/static-files/52042af4-ea50-435f-a73f-e271983f9f9b.png" alt="{{ l('Credit card') }}"/>
                        <span class="mp-text-beneficios">{{ l('Charge as you want and sell without limits.') }}</span>
                    </div>
                    
                    <div class="mp-panel-text-icon">
                        <img class="img-fluid icon-mercadopago" src="https://http2.mlstatic.com/storage/cpp/static-files/6ef8c800-364d-44e9-9df6-c7d7fb6977fb.png" alt="{{ l('Ticket') }}"/>
                        <span class="mp-text-beneficios">
                            {{ l('Maximize your conversion with the best payment experience.') }}
                        </span>
                    </div>
                    
                    <div class="mp-panel-text-icon">
                        <img class="img-fluid icon-mercadopago" src="https://http2.mlstatic.com/storage/cpp/static-files/87e4f433-eaa8-42df-83f7-8278eba23022.png" alt="{{ l('Custom') }}"/>
                        <span class="mp-text-beneficios">
                            {{ l('You have ready-to-use tools and specialists willing to help you.') }}
                        </span>
                    </div>
                </div>
                
                <div class="col-md-6">
                    <img class="img-fluid mp-img-beneficios" src="https://http2.mlstatic.com/storage/cpp/static-files/8d3e158e-7e23-430e-bfed-ae2d52c225db.png" alt="{{ l('Benefit') }}"/>
                </div>
            </div>
        </div>
        
        {# Seção "Como Receber Pagamentos" #}
        <div class="mercadopago-recibopagos">
            <div class="row">
                <h2 class="mp-title-recibopagos">{{ l('How do I receive the payments?') }}</h2>
                
                <div class="col-md-4 text-center mp-px-10">
                    <p class="mp-number-recibopagos mp-number-recibopagos-after">1</p>
                    <p class="mp-text-checkout-body">{{ l('Your customers pay as they prefer.') }}</p>
                </div>
                
                <div class="col-md-4 text-center mp-px-10">
                    <p class="mp-number-recibopagos mp-number-recibopagos-after mp-number-recibopagos-before-green">2</p>
                    <p class="mp-text-checkout-body">
                        {{ l('The money is credited to your Mercado Pago account.') }}
                    </p>
                </div>
                
                <div class="col-md-4 text-center mp-px-10">
                    <p class="mp-number-recibopagos mp-number-recibopagos-before">3</p>
                    <p class="mp-text-checkout-body">
                        {{ l('Once available, you transfer it at no additional cost to your bank account.') }}
                    </p>
                </div>
            </div>
        </div>
        
        {# Seção "O que Posso Fazer" #}
        <div class="mercadopago-beneficios">
            <div class="row">
                <div class="col-md-6">
                    <img class="img-fluid mp-img-puedohacer" src="https://http2.mlstatic.com/storage/cpp/static-files/56428e0d-9b28-4445-b2a1-1909fe680021.png" alt="{{ l('Store features') }}" />
                </div>
                <div class="col-md-6">
                    <div class="mp-panel-title">
                        <h2 class="mp-title-beneficios mp-beneficios-icon">
                            {{ l('What can I do with Mercado Pago in my store?') }}
                        </h2>
                    </div>
                    <div class="mp-panel-text-icon mp-beneficios-icon">
                        <img class="img-fluid icon-mercadopago" src="https://http2.mlstatic.com/storage/cpp/static-files/fcb4c10d-806b-47d5-9651-b7c317269ee4.png" alt="{{ l('One click purchase') }}" />
                        <span class="mp-text-beneficios">
                            {{ l('One click purchase: we remember the data of your logged users.') }}
                        </span>
                    </div>
                    
                    <div class="mp-panel-text-icon mp-beneficios-icon">
                        <img class="img-fluid icon-mercadopago mp-pl-2 mp-pr-20" src="https://http2.mlstatic.com/storage/cpp/static-files/ae45e403-b371-466b-899c-59ca9e300941.png" alt="{{ l('Payment as guest') }}" />
                        <span class="mp-text-beneficios">
                            {{ l('Payment as a guest: your customers do not have to open a Mercado Pago account.') }}
                        </span>
                    </div>
                    
                    <div class="mp-panel-text-icon mp-beneficios-icon">
                        <img class="img-fluid icon-mercadopago" src="https://http2.mlstatic.com/storage/cpp/static-files/65fe3922-133e-4a2b-9ee9-25531b8e82ab.png" alt="{{ l('Return of payments') }}" />
                        <span class="mp-text-beneficios">
                            {{ l('Return of payments and cancellation of pending payments.') }}
                        </span>
                    </div>
                </div>
            </div>
        </div>
        
        {# Rodapé #}
        <div class="mercadopago-footer">
            <div class="row">
                <div class="col-md-12">
                    <h2 class="mp-title-footer">
                        {{ l('Going further is in your hands. Offer your customers a unique payment experience.') }}
                    </h2>
                    <a href="#tab-config" class="btn btn-default mp-btn-footer">{{ l('Configure Mercado Pago in your store') }}</a>
                </div>
            </div>
        </div>
        
        {# Seção de Parceiros #}
        <div class="mercadopago-partner">
            <div class="row">
                <div class="col-md-6 mp-left-partner">
                    <img class="img-fluid mp-img-partner" src="https://http2.mlstatic.com/storage/cpp/static-files/39ec7cb9-e9e5-401e-861d-9694b72d623a.png" alt="{{ l('PrestaShop Partner') }}" />
                    <span>{{ l('We are official partners of Prestashop') }}</span>
                </div>
                
                <div class="col-md-6 mp-right-partner">
                    <a href="https://www.mercadopago.com/activities/seller-protection" target="_blank" class="mp-fl-right">{{ l('Seller Protection Program.') }}</a>
                </div>
            </div>
        </div>
    </div>
</div>
